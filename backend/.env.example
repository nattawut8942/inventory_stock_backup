# Database Configuration
# Please fill in your SQL Server details
DB_SERVER=192.168.226.86
DB_DATABASE=dbITMS
DB_USER=sa
DB_PASSWORD=decjapan
DB_PORT=1433


# Set to 'true' to use Windows Authentication (no user/password needed)
DB_TRUSTED_CONNECTION=false


# JWT signing secret (required, >= 32 chars) — generate a random value
JWT_SECRET=

# IP scan API key (shared by server and auto_scan.js)
IP_SCAN_API_KEY=

# ── Page-level permissions ──
# log     (default) : nothing is blocked; Management > Users > "รายงานตรวจสิทธิ์" lists who WOULD be blocked
# enforce           : actions without the right permission get 401/403
# off               : check disabled (routes that were Admin-only before still require the Admin role)
# Routes that used to be Admin-only are always enforced, whatever this is set to. Restart the backend after changing it.
PERMISSIONS_MODE=log
